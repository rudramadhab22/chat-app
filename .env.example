# Copy this file to `.env` in the project root and fill in real values.
# `.env` is gitignored — never commit secrets.

SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/chat_app_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=rudra
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# Optional
JWT_EXPIRATION_MS=86400000
UPLOAD_DIR=uploads
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
